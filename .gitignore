# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# 코드가 아닌 개인 업무 참고 자료 (실제 신고 일정·예시 엑셀 등)는 저장소에 올리지 않는다
*.xlsx

# Supabase CLI가 로컬에 만드는 캐시 파일 (버전 관리 대상 아님)
/supabase/.temp

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
